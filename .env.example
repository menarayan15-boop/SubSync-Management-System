# ==============================================================================
# SudSync - Environment Configuration Template
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Configuration (MongoDB Atlas or local MongoDB)
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/subsync?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/subsync

# JWT Authentication
JWT_SECRET=your_jwt_super_secret_key_change_in_production
JWT_EXPIRES_IN=7d

# Razorpay Test Mode Configuration
# Get keys from: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=placeholder_secret_key

# Email Service Configuration (Optional / SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_email_app_password
EMAIL_FROM=SubSync <no-reply@subsync.com>
